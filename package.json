{
  "name": "ubeer",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @ubeer/web",
    "dev:api": "npm run dev -w @ubeer/api",
    "dev:web": "npm run dev -w @ubeer/web",
    "db:generate": "npm run db:generate -w @ubeer/api",
    "db:migrate": "npm run db:migrate -w @ubeer/api",
    "db:seed": "npm run db:seed -w @ubeer/api"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true,
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "prisma@6.12.0": true
  }
}
