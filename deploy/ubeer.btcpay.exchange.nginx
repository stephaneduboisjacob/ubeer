server {
    listen 80;
    listen [::]:80;
    server_name ubeer.btcpay.exchange;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ubeer.btcpay.exchange;

    ssl_certificate     /etc/letsencrypt/live/ubeer.btcpay.exchange/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ubeer.btcpay.exchange/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 10m;
    root /var/www/ubeer/web;
    index index.html;

    location ^~ /downloads/ {
        default_type application/vnd.android.package-archive;
        add_header Content-Disposition attachment always;
        try_files $uri =404;
    }

    location /api/webhooks/btcpay {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
